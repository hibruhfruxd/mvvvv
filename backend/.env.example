# ============================================================
# MeruVeda Backend (Express + TypeScript) — Environment Variables
# Copy this file to .env and fill in the real values.
# Never commit .env. Names only below — no values are provided
# here on purpose.
#
# ALL backend variables are RUNTIME vars: Hostinger injects them
# into the Node process (hPanel → Node.js → environment variables)
# and they are read on each boot / per request. `next build`-style
# inlining does not exist here, so changing one only requires a
# restart, not a rebuild. dotenv is skipped when NODE_ENV=production.
#
# NOTE: a few variables have aliases; the code accepts the first
# non-empty spelling. Aliases are listed next to the primary name.
# ============================================================

# --- Server ---
# PORT is assigned by Hostinger — do NOT hardcode it; the app listens
# on process.env.PORT and binds 0.0.0.0.
PORT=
# production in the hosted environment (the boot-time audit runs then)
NODE_ENV=
# Hops of reverse proxy in front of the API (Hostinger nginx = 1)
TRUST_PROXY_HOPS=

# --- Neon Postgres ---
# Pooled connection used by the API at runtime (host contains "-pooler.")
DATABASE_URL=
# Least-privilege runtime role (created by `npm run db:role`); pooled too
DATABASE_URL_APP=
# Direct (unpooled) connection used by migrations/DDL only
DATABASE_URL_UNPOOLED=

# --- Cloudflare R2 (media + invoice buckets) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=
R2_BUCKET_INVOICES=
# https URL browsers read media from (pub-xxx.r2.dev or a custom domain)
R2_PUBLIC_BASE_URL=
# Optional extra hostname allowlist for /api/images/fetch, beyond R2_PUBLIC_BASE_URL
IMAGE_PROXY_EXTRA_HOSTS=
# Private bucket for invoice PDFs (default 'invoice' matches the migrations)
INVOICE_STORAGE_BUCKET=
INVOICE_SIGNED_URL_EXPIRY_SECONDS=

# --- Auth / sessions ---
JWT_SECRET=
JWT_EXPIRES_IN=
# Server-side pepper for OTP digests (any one spelling is accepted)
OTP_HASH_PEPPER=
OTP_HASH_SECRET=
OTP_HMAC_SECRET=
# Deployment-wide daily ceiling for OTP sends (default 500)
OTP_DAILY_SEND_CAP=
# Checkout auth mode: 'auto' | 'on' | 'off' (default auto)
OTP_MODE=
# true = WhatsApp OTP endpoints respond; false = they answer 503
OTP_ENABLED=
# Storefront account pages (login/signup/reset). true = enabled
ACCOUNT_PAGES_ENABLED=

# --- CORS ---
# Comma-separated allowlist, no wildcards. REQUIRED in production
# (server refuses to boot when empty). Include the storefront apex,
# www, and the API origin (the admin SPA is served by this backend,
# so its browser Origin is https://api.meruvedawellness.com).
# Example: https://meruvedawellness.com,https://www.meruvedawellness.com,https://api.meruvedawellness.com
ALLOWED_ORIGINS=
# Public base URL of the storefront (payment redirects, email links,
# CORS storefront expansion, invoice footer). Must be https in production.
FRONTEND_URL=
# Public base URL of THIS backend (Meta webhook callback, PayU surl/furl).
# Hostinger: https://api.meruvedawellness.com
BACKEND_URL=
# Optional: separate storefront URL override used only for ISR revalidation
STOREFRONT_URL=
# Shared secret for POST /api/revalidate on the frontend; must match the
# frontend's REVALIDATE_SECRET
REVALIDATE_SECRET=

# --- Scheduled jobs ---
# Bearer secret the scheduler sends to /api/jobs/* (Hostinger cron or
# any external scheduler). Required in production (boot refuses otherwise).
CRON_SECRET=

# --- PayU Payment Gateway ---
PAYU_MERCHANT_KEY=
PAYU_SALT=
# 'test' | 'live' — code derives the PayU endpoint from this flag
PAYU_MODE=
# Optional explicit endpoint override (only checked as a warning)
PAYU_BASE_URL=
# Note: PayU surl/furl are built at runtime from BACKEND_URL / the request
# host — no PAYU_SUCCESS_URL / PAYU_FAILURE_URL variables exist.

# --- Migrations ---
# Bearer secret protecting POST /api/migration/*
MIGRATION_SECRET=

# --- Shiprocket ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# MUST be the /v1/external surface
SHIPROCKET_BASE_URL=
# Pickup location name exactly as in the Shiprocket dashboard
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
# Numeric channel id from Shiprocket > Settings > Channels
SHIPROCKET_CHANNEL_ID=
# Shared token checked (timing-safe) against x-api-key on the webhook
SHIPROCKET_WEBHOOK_TOKEN=
# TESTING SWITCH — must stay "false" in production
SHIPROCKET_TEST_MODE=
# ON BY DEFAULT; set literal "false" to pause automatic pushes
SHIPROCKET_AUTO_PUSH=
SHIPROCKET_DEFAULT_WEIGHT_KG=
SHIPROCKET_DEFAULT_LENGTH_CM=
SHIPROCKET_DEFAULT_BREADTH_CM=
SHIPROCKET_DEFAULT_HEIGHT_CM=

# --- Tax / invoicing ---
# GSTIN printed on invoices (15 chars). BUSINESS_GSTIN wins over GSTIN.
GSTIN=
SHIPPING_IS_TAXABLE=
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
BUSINESS_PHONE=
BUSINESS_EMAIL=
# ON BY DEFAULT; set literal "false" to pause invoice delivery (read per dispatch)
INVOICE_AUTO_SEND=

# --- Transactional email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Notifications to the store owner ---
ADMIN_WHATSAPP_NUMBER=

# --- WhatsApp Cloud API (Meta) ---
# Either spelling is accepted for the token; the first non-empty wins
WHATSAPP_API_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Template names must match APPROVED Meta templates exactly
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_REVIEW_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=
# Meta App Dashboard > Settings > Basic > App Secret (webhook signature check)
WHATSAPP_APP_SECRET=
# Any random string you choose — must match what you paste into Meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=
# Never "true" in production (boot refuses)
WHATSAPP_DRY_RUN=
# WhatsApp invoice delivery (master flag; default false = inert)
WHATSAPP_INVOICE_ENABLED=
# 'document' | 'link'
WHATSAPP_INVOICE_MODE=
WHATSAPP_INVOICE_TEMPLATE_NAME=
WHATSAPP_INVOICE_TEMPLATE_LANG=
# Alias spellings also accepted for the invoice template settings
INVOICE_WA_TEMPLATE_NAME=
INVOICE_WA_TEMPLATE_LANG=
# How far back the delivery sweep looks for undelivered invoices
WHATSAPP_BACKFILL_DAYS=

# --- Upstash Redis (optional but recommended in production) ---
# Powers distributed rate limiting + the Shiprocket token cache.
# Without it, limits are per-instance only (logged loudly at boot).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google Identity Toolkit (currently unused) ---
GOOGLE_IDENTITY_TOOLKIT_API_KEY=

# --- Admin panel (optional) ---
# Absolute path to the built admin SPA (Vite outDir: admin/dist/admin).
# Defaults to <repo>/admin/dist/admin relative to the compiled backend.
# Set only when the admin bundle lives elsewhere on the host.
ADMIN_DIST_DIR=
