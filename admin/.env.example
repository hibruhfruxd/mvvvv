# ============================================================
# MeruVeda Admin (Vite + React) — Environment Variables Reference
# Copy this file to .env.local and fill in the real values.
# VITE_* variables are embedded in the client bundle —
# never put secrets in these variables.
# ============================================================

# Base URL of the backend API (no trailing slash)
# Dev:  http://localhost:5000/api
# Prod: https://api.meruvedawellness.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# URL of the customer-facing storefront — used for "View Store" links
# Dev:  http://localhost:3000
# Prod: https://meruvedawellness.com
VITE_CUSTOMER_WEBSITE_URL=http://localhost:3000

# External Web Analytics dashboard URL for this project (optional).
# Shown as the "Open … Analytics" button on the admin Analytics page.
# If you stay on Vercel after the migration, use the Vercel dashboard's
# share link here. Leave empty to hide the button.
VITE_VERCEL_ANALYTICS_URL=
