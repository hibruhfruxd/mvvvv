# ============================================================
# MeruVeda Frontend (Next.js) — Environment Variables
# Copy this file to .env.local and fill in the real values.
# Never commit .env / .env.local. Names only below — no values
# are provided here on purpose.
#
# BUILD-TIME vars (NEXT_PUBLIC_*, BACKEND_SERVICE_URL, R2_PUBLIC_BASE_URL)
# are inlined into the client bundle / the build output. Changing them
# requires a REBUILD + redeploy.
# RUNTIME vars are read by the Next server (route handlers, rewrites)
# and can be changed with a restart only.
# ============================================================

# --- BUILD-TIME ---

# Backend service origin (no trailing slash, no /api path). Used by the
# /api/* rewrite in next.config.ts. REQUIRED when building for production
# outside Vercel (e.g. Hostinger): `next build` fails without it.
# Hostinger value: https://api.meruvedawellness.com
BACKEND_SERVICE_URL=

# R2 public media host (https URL). Baked into next.config.ts
# images.remotePatterns at build time. Read at build; changing it
# requires a rebuild.
R2_PUBLIC_BASE_URL=

# API base URL (no trailing slash), used by SSR fetches and as the
# rewrite fallback when BACKEND_SERVICE_URL is unset.
# Must be https in production.
NEXT_PUBLIC_API_URL=

# URL of the admin dashboard, used for "Go to Admin" links.
# Production: https://api.meruvedawellness.com/admin (backend-served) or
# https://admin.meruvedawellness.com if you split it out later.
NEXT_PUBLIC_ADMIN_URL=

# WhatsApp OTP checkout flow. Default false. Must match backend OTP_ENABLED.
NEXT_PUBLIC_OTP_ENABLED=

# Master switch for GA4 ("true" enables GA4). Setting "false" also disables Meta Pixel.
NEXT_PUBLIC_ANALYTICS_ENABLED=

# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX). Empty = disabled.
NEXT_PUBLIC_GA_ID=

# Meta Pixel id, digits only. Defaults to 1106420419060702 when unset; set "" to disable.
NEXT_PUBLIC_META_PIXEL_ID=

# --- RUNTIME (read by the Next server, not inlined into the client) ---

# Shared secret for POST /api/revalidate (backend sends it as
# x-revalidate-token after admin writes). Must match backend REVALIDATE_SECRET.
REVALIDATE_SECRET=

# --- Optional build-time switches (CI / local tooling) ---
# CHECK_REVIEWS_STRICT=1   forces the review-check script to fail the build
# NODE_ENV                 set to production by the platform
